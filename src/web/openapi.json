            "in": "query",
            "description": "Starts at 1.",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 1
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "1 to 100.",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "example": 20
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
