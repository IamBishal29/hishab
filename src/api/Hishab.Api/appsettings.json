{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Observability": {
    "SeqUrl": "",
    "JsonConsole": true
  },
  "Risk": {
    "RiskyMinReturns": 2,
    "RiskyReturnRate": 0.5,
    "WatchReturnRate": 0.3,
    "RecentReturnDays": 90,
    "WatchCancellations": 3
  },
  "AllowedHosts": "*"
}
