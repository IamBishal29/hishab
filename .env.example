# Copy to .env (git-ignored) and fill in. Never commit real values.

# Local PostgreSQL started by docker compose
POSTGRES_PASSWORD=change-me

# The API reads its connection string from user-secrets in development:
#   dotnet user-secrets set "Database:ConnectionString" "Host=localhost;Port=5432;Database=hishab;Username=hishab;Password=<POSTGRES_PASSWORD>" --project src/api/Hishab.Api
# or from the environment variable Database__ConnectionString.
